<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Grdp.SoftwareIntegration.Worker</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**\*;tests/**/*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Grdp.SoftwareIntegration.Worker.Tests" />
    <Compile Remove="tests\**\*;tests/**/*" />
    <Content Remove="tests\**\*;tests/**/*" />
    <EmbeddedResource Remove="tests\**\*;tests/**/*" />
    <None Remove="tests\**\*;tests/**/*" />
    <Content Include="ptk_validate.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ptk_run.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ptk_normalization.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
