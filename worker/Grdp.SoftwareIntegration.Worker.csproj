<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Grdp.SoftwareIntegration.Worker</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**\*;tests/**/*;bin\**;bin/**;obj\**;obj/**;bin-*\**;bin-*/**;obj-*\**;obj-*/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Grdp.SoftwareIntegration.Worker.Tests" />
    <Compile Remove="tests\**\*;tests/**/*" />
    <Content Remove="tests\**\*;tests/**/*" />
    <EmbeddedResource Remove="tests\**\*;tests/**/*" />
    <None Remove="tests\**\*;tests/**/*" />
    <Content Include="ptk_validate.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ptk_well_inspection.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ptk_run.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ptk_normalization.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ptk_network.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ptk_create_template.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\tools\pipesim_template_preflight.py" Link="pipesim_template_preflight.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\tools\pipesim_template_profile.py" Link="pipesim_template_profile.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
